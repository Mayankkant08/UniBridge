generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Attendance {
  id            String           @id @default(uuid())
  studentId     String
  courseId      String
  classDate     DateTime         @default(now())
  status        AttendanceStatus @default(ABSENT)
  markedAt      DateTime?
  qrTokenId     String?
  teacherId     String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([studentId, courseId, classDate])
  @@index([studentId])
  @@index([courseId])
  @@index([classDate])
  @@map("attendances")
}

model QRToken {
  id         String   @id @default(uuid())
  teacherId  String
  courseId   String
  token      String   @unique
  signature  String
  expiresAt  DateTime
  isActive   Boolean  @default(true)
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
  @@map("qr_tokens")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}
